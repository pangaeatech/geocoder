{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "poetry build *": "allow",
      "poetry check *": "allow",
      "poetry run black *": "allow",
      "poetry run coverage *": "allow",
      "poetry run mypy *": "allow",
      "poetry run pdoc *": "allow",
      "poetry run pylint *": "allow",
      "poetry run pytest *": "allow",
      "poetry show *": "allow"
    },
    "edit": {
        "**/.gitignore": "allow",
        "**/.pylintrc": "allow",
        "**/*.py": "allow",
        "**/*.md": "allow",
        "**/*.yml": "allow",
        "**/poetry.lock": "allow",
        "**/pyproject.toml": "allow",
        "**/pytest.ini": "allow",
        "**/renovate.json": "allow"
    }
  }
}
